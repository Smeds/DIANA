/*
 * ============================================================================
 * Diana Pipeline - SLURM Configuration
 * ============================================================================
 *
 * Loaded by the `slurm` profile in nextflow.config (use with Apptainer/Singularity):
 *
 *   ./run_pipeline_singularity.sh --run_mode_order -profile slurm \
 *       --slurm_account my_project --slurm_queue core
 *
 * Every process is submitted as its own SLURM job; the nextflow process itself
 * stays on the node you launch it from and must keep running until the pipeline
 * finishes (run it in tmux/screen, or inside a long-running sbatch job).
 *
 * Requirements:
 *   - The work directory (-w), the pipeline directory (containers/*.sif),
 *     params.path/ref_dir and params.output_path must be on a filesystem that
 *     the compute nodes share with the launch node.
 *   - apptainer/singularity must be available on the compute nodes
 *     (use --slurm_before_script 'module load apptainer' if it is a module).
 *
 * Per-process cpus/memory come from conf/annotation.config, conf/epi2me.config
 * and conf/mergebam.config (withName selectors); the values below only apply to
 * processes that don't set them there.
 * ============================================================================
 */

params {
    slurm_account         = null    // --account; required on most clusters
    slurm_queue           = null    // --partition; null uses the cluster default
    slurm_cluster_options = null    // extra sbatch flags, e.g. '--qos=high'
    slurm_before_script   = null    // shell run before each task, e.g. 'module load apptainer'
    slurm_queue_size      = 50      // max jobs Nextflow keeps queued/running at once
    slurm_time            = '12h'   // default per-task walltime; doubled on retry
}

process {
    executor       = 'slurm'
    queue          = params.slurm_queue
    clusterOptions = [
        params.slurm_account ? "--account=${params.slurm_account}" : null,
        params.slurm_cluster_options
    ].findAll { it }.join(' ')
    beforeScript   = params.slurm_before_script ?: ''

    // Defaults for processes without explicit resources
    cpus   = 1
    memory = '4 GB'
    time   = { (params.slurm_time as nextflow.util.Duration) * task.attempt }

    // Retry once when SLURM kills a job (OOM 137, walltime 140, SIGTERM 143)
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1
}

executor {
    queueSize         = params.slurm_queue_size
    submitRateLimit   = '10/1min'
    pollInterval      = '30 sec'
    queueStatInterval = '1 min'
}
